# Android 13, virtual A/B, dynamic partitions.
# ro.hardware = mt6768 on this device, so the file name is correct.
# Verification is disabled via vbmeta --flags 3, so there are no avb= entries.
#
# <src>                       <mnt_point>  <type>  <mnt_flags>                                <fs_mgr_flags>
system                        /system      ext4    ro,barrier=1                              wait,slotselect,logical,first_stage_mount
system_ext                    /system_ext  ext4    ro,barrier=1                              wait,slotselect,logical,first_stage_mount
product                       /product     ext4    ro,barrier=1                              wait,slotselect,logical,first_stage_mount
vendor                        /vendor      ext4    ro,barrier=1                              wait,slotselect,logical,first_stage_mount

# Partition name confirmed by the working PBRP build: `metadata`, not `md_udc`.
/dev/block/by-name/metadata   /metadata    ext4    noatime,nosuid,nodev,discard              wait,formattable,first_stage_mount

/dev/block/by-name/userdata   /data        f2fs    noatime,nosuid,nodev,discard,noflush_merge,inlinecrypt,reserve_root=134217,resgid=1065,tran_gc wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption,fscompress

# Required on virtual A/B: update_engine reads this entry to find the boot device.
# Deleting it breaks OTA installs, not the boot.
/dev/block/by-name/misc       /misc        emmc    defaults                                  defaults
